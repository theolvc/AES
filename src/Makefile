INCLUDEDIR=../include
CFLAGS=-std=c11 -Wall -Wextra -g -O3
CPPFLAGS=-I$(INCLUDEDIR)
LDFLAGS = -lm
CC = gcc

all: ../AES

../AES: AES.o maths.o cipher.o state.o block.o WBC.o
	$(CC) $(CFLAGS) -o ../AES AES.o maths.o cipher.o state.o block.o WBC.o

AES.o: AES.c $(INCLUDEDIR)/AES.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $<

maths.o: maths.c $(INCLUDEDIR)/maths.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $<

cipher.o: cipher.c $(INCLUDEDIR)/cipher.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $<

state.o: state.c $(INCLUDEDIR)/state.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $<

block.o: block.c $(INCLUDEDIR)/block.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $<

WBC.o : WBC.c $(INCLUDEDIR)/WBC.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $<

bijection.o: bijection.c $(INCLUDEDIR)/bijection.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $<

clean :
	@rm -f *.o AES ../AES ../include/*.gch AES ../*.txt ../src/*.txt

help:
	@echo "Usage:"
	@echo " make [all]\t\tBuild the software"
	@echo " make clean\t\tRemove all files generated by make"
	@echo " make help\t\tDisplay this help"
	@echo " make test\t\tTest the program"

test:
	../test.sh ../AES alice.sage


.PHONY: all clean help test report

